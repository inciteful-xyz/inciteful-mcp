# All five are required; the server refuses to start if any is missing or blank.
# Graph API base URL tried first (http or https, no credentials, query or fragment).
GRAPH_API_PRIMARY_URL=
# Graph API base URL tried only when the primary cannot be reached.
GRAPH_API_SECONDARY_URL=
# OpenAlex API key, sent only in the Authorization: Bearer header.
OPENALEX_ACADEMIC_API_KEY=
# Public URL of the MCP endpoint (canonical), e.g. https://incitefulmed.com/academic/mcp
PUBLIC_BASE_URL=
# Path of the SQLite usage log file.
USAGE_DB_PATH=
