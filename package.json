{
  "name": "inciteful-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP tools combining Inciteful citation graphs and OpenAlex metadata",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:review": "node scripts/review-smoke.mjs",
    "smoke:content": "node scripts/content-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "fast-xml-parser": "^5.11.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
